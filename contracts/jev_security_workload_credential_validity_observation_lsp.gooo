module jev_security_workload_credential_validity_observation_lsp

input status
input workload_spiffe_id
input issuer_spiffe_id
input audience
input credential_digest
input evidence_prefix_digest
input issued_at_unix
input expires_at_unix
input observed_at_unix
input revocation_status
input observation_digest

status INFORMATION valid credential validity evidence is available for inspection
status WARNING credential validity producer is deferred
status ERROR missing, expired, revoked, malformed, or tampered credential evidence

field publishable
field code
field message
field missing_stage
field projection_digest

constraint temporal_projection
constraint revocation_projection
constraint inspection_only
constraint no_authorization
constraint no_execution
constraint read_only
constraint no_edits
constraint no_command