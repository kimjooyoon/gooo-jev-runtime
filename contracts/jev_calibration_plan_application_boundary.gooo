module jev_calibration_plan_application_boundary

input source_version
input contract_version
input route_record_digest
input plan_digest
input route_status
input producer_deferred

status PROPOSED for evidence-bound route candidates
status DEFERRED for deferred producer or route evidence
status UNKNOWN for missing identity, route record, plan digest, or unresolved route

field target_stage
field boundary_digest

constraint proposal_only
constraint read_only
constraint no_edits
constraint no_command
constraint no_execution
constraint no_authorization